[Unit]
Description=Braillatron ready banner on local console
ConditionPathExists=!/etc/braillatron/appliance-headless
After=braillatron-ui.service
PartOf=braillatron.target
ConditionPathExists=/usr/local/sbin/braillatron-console-ready.sh

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/braillatron-console-ready.sh
RemainAfterExit=yes

[Install]
WantedBy=braillatron.target
