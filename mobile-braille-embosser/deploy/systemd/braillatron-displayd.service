[Unit]
Description=Braillatron remote display sidecar
After=local-fs.target braillatron-ui.service

[Service]
Type=simple
RuntimeDirectory=braillatron
Environment=BRAILLATRON_REMOTE_DISPLAY_CONFIG=/data/braillatron/settings/remote-display.conf
ExecStart=/usr/local/bin/braillatron-displayd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=braillatron.target
