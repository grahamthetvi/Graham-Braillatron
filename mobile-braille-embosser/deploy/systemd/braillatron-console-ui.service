[Unit]
Description=Braillatron ScreenReader UI on HDMI tty (ncurses fallback)
ConditionPathExists=!/etc/braillatron/appliance-spi
ConditionPathExists=!/etc/braillatron/appliance-headless
After=local-fs.target sound.target speech-dispatcher.service
Conflicts=braillatron-ui.service braillatron-ui-stub.service
Wants=speech-dispatcher.service
Wants=brltty.service braillatron-connectd.service

[Service]
Type=simple
SupplementaryGroups=input
EnvironmentFile=-/etc/braillatron/appliance.env
Environment=BRAILLATRON_CONFIG=/etc/braillatron
Environment=TERM=linux
Environment=SPEECHD_ADDRESS=unix_socket:/run/speech-dispatcher/speechd.sock
ExecStartPre=/usr/local/sbin/braillatron-console-ready.sh --no-wait
ExecStart=/usr/bin/openvt -c 1 -s -w -f -- /usr/local/bin/braillatron-ui /etc/braillatron/hardware.conf
Restart=always
RestartSec=5

[Install]
WantedBy=braillatron.target
