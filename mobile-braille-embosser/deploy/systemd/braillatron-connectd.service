[Unit]
Description=Braillatron connectivity sidecar
After=network-online.target
Before=braillatron-ui.service

[Service]
Type=simple
RuntimeDirectory=braillatron
Environment=BRAILLATRON_CONFIG=/etc/braillatron
ExecStart=/usr/local/bin/braillatron-connectd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=braillatron.target
