[Unit]
Description=Braillatron ScreenReader UI
ConditionPathExists=!/etc/braillatron/appliance-headless
After=local-fs.target sound.target speech-dispatcher.service braillatron-displayd.service
Conflicts=braillatron-ui-stub.service
Requires=speech-dispatcher.service
Wants=brltty.service braillatron-connectd.service braillatron-displayd.service

[Service]
Type=simple
SupplementaryGroups=input video
EnvironmentFile=-/etc/braillatron/appliance.env
Environment=BRAILLATRON_CONFIG=/etc/braillatron
Environment=BRAILLATRON_REMOTE_DISPLAY_CONFIG=/data/braillatron/settings/remote-display.conf
Environment=SPEECHD_ADDRESS=unix_socket:/run/speech-dispatcher/speechd.sock
ExecStart=/usr/local/bin/braillatron-ui /etc/braillatron/hardware.conf
Restart=always
RestartSec=5

[Install]
WantedBy=braillatron.target
