[Unit]
Description=Braillatron ScreenReader UI (SPI panel)
EnvironmentFile=-/etc/braillatron/appliance.env
ConditionPathExists=/etc/braillatron/appliance-spi
After=local-fs.target sound.target speech-dispatcher.service
Conflicts=braillatron-console-ui.service
Requires=speech-dispatcher.service
Wants=brltty.service braillatron-connectd.service

[Service]
Type=simple
SupplementaryGroups=input
EnvironmentFile=-/etc/braillatron/appliance.env
Environment=BRAILLATRON_CONFIG=/etc/braillatron
Environment=SPEECHD_ADDRESS=unix_socket:/run/speech-dispatcher/speechd.sock
ExecStart=/usr/local/bin/braillatron-ui /etc/braillatron/hardware.conf
Restart=always
RestartSec=5

[Install]
WantedBy=braillatron.target
